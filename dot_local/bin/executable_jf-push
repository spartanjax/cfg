#!/bin/sh
# jf-push — commit and push the current dotfiles state.
#
# Usage:
#   jf-push                 # commit with a default message
#   jf-push "my message"    # commit with a custom message
set -e
src="$(chezmoi source-path)"
msg="${*:-chore: update dotfiles}"
git -C "$src" add -A
if git -C "$src" diff --cached --quiet; then
    echo "jf-push: nothing to commit"
else
    git -C "$src" commit -m "$msg"
fi
git -C "$src" push
