# ~/.zshrc — managed by cfg (chezmoi). macOS only.

# Homebrew on PATH (Apple Silicon: /opt/homebrew, Intel: /usr/local).
if [ -x /opt/homebrew/bin/brew ]; then
    eval "$(/opt/homebrew/bin/brew shellenv)"
elif [ -x /usr/local/bin/brew ]; then
    eval "$(/usr/local/bin/brew shellenv)"
fi

# User-local binaries (cfg-* wrappers, etc.) and opencode.
export PATH="$HOME/.local/bin:$HOME/.opencode/bin:$PATH"

# Shared shell aliases (git shortcuts, `oc`, …).
[ -f "$HOME/.config/shell/aliases.sh" ] && . "$HOME/.config/shell/aliases.sh"
