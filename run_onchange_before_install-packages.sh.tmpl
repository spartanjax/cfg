{{ if eq .chezmoi.os "darwin" -}}
#!/bin/sh
# macOS packages. Runs again when the Brewfile (or this list) changes.
# Brewfile hash: {{ include "Brewfile" | sha256sum }}
brew bundle --file={{ joinPath .chezmoi.sourceDir "Brewfile" | quote }}
{{ else if eq .chezmoi.os "linux" -}}
#!/bin/sh
# Debian/Ubuntu packages. Runs again when this list changes.
sudo apt-get update
sudo apt-get install -y tmux ripgrep fzf fd-find bat jq tree
{{ end -}}
